MAS simple {
    infrastructure: Centralised
    environment: environment.GridEnvironment

    agents:
        john secondAgent.asl;  // Agent name and ASL file

    aslSourcePath:
        "agents-folder/AgentsAsl";  // Path to ASL files

    // Optional but recommended for your grid environment:
    executionControl:
        sync = true;  // Synchronized execution
        delay = 200;  // 200ms delay between cycles (matches your Thread.sleep)
}